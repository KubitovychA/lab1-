:root {
  --bg: #F4F5F7;
  --surface: #FFFFFF;
  --text: #1F2937;
  --muted: #4B5563;
  --accent: #2563EB;
  --accent-hover: #1D4ED8;
  --border: #D1D5DB;
  --danger: #B91C1C;
  --focus: #111827;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  background: var(--bg);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
}

button {
  font: inherit;
}

.page {
  width: min(100% - 32px, 760px);
  margin: 48px auto;
}

.page__title {
  margin: 0 0 20px;
  font-size: 28px;
  line-height: 1.2;
}

.cart-card {
  display: flex;
  align-items: stretch;
  gap: 20px;
  width: 100%;
  padding: 20px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
  transition: border-color 160ms ease, box-shadow 160ms ease;
}

.cart-card:hover {
  border-color: var(--accent);
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.09);
}

.cart-card__image {
  width: 140px;
  height: 140px;
  flex: 0 0 140px;
  object-fit: cover;
  border-radius: 12px;
  background: var(--bg);
}

.cart-card__content {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  justify-content: space-between;
  gap: 24px;
}

.cart-card__title {
  margin: 0 0 6px;
  font-size: 22px;
  line-height: 1.25;
}

.cart-card__description {
  margin: 0 0 12px;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.4;
}

.cart-card__price {
  margin: 0;
  color: var(--text);
  font-size: 20px;
  font-weight: 700;
}

.cart-card__actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.quantity {
  display: inline-flex;
  align-items: center;
  border: 1px solid var(--border);
  border-radius: 10px;
  overflow: hidden;
}

.quantity__button {
  width: 40px;
  height: 40px;
  padding: 0;
  border: 0;
  background: var(--surface);
  color: var(--text);
  cursor: pointer;
  font-size: 22px;
  line-height: 1;
}

.quantity__button:hover {
  background: var(--bg);
}

.quantity__value {
  display: grid;
  min-width: 42px;
  height: 40px;
  place-items: center;
  border-inline: 1px solid var(--border);
  font-weight: 700;
}

.delete-button {
  min-height: 40px;
  padding: 8px 14px;
  border: 1px solid var(--danger);
  border-radius: 10px;
  background: var(--surface);
  color: var(--danger);
  cursor: pointer;
  font-weight: 700;
  transition: background 160ms ease, color 160ms ease;
}

.delete-button:hover,
.delete-button--confirm {
  background: var(--danger);
  color: var(--surface);
}

button:focus-visible {
  outline: 3px solid var(--focus);
  outline-offset: 3px;
}

.status {
  min-height: 24px;
  margin: 16px 0 0;
  color: var(--muted);
  font-size: 14px;
}

@media (max-width: 560px) {
  .page {
    width: min(100% - 20px, 760px);
    margin: 24px auto;
  }

  .cart-card {
    flex-direction: column;
    padding: 16px;
  }

  .cart-card__image {
    width: 100%;
    height: 190px;
    flex-basis: auto;
  }

  .cart-card__actions {
    align-items: stretch;
    flex-direction: column;
  }

  .quantity {
    justify-content: center;
  }

  .delete-button {
    width: 100%;
  }
}
